{
  "id": "cinematic_dataviz",
  "name": "Cinematic Data Visualization",
  "description": "Sophisticated atmospheric dark canvas with luminous neon accents, generous breathing room, refined geometric typography, and floating data telemetry cards (9:16 vertical)",
  "colors": {
    "background": "#060913",
    "foreground": "#f1f5f9",
    "secondary": "#94a3b8",
    "muted": "#475569",
    "accent": "#06b6d4",
    "accent_secondary": "#f43f5e",
    "card_bg": "#0c1322",
    "card_border": "#1e293b",
    "code_bg": "#080e1a",
    "badge_bg": "#082f49",
    "badge_text": "#38bdf8"
  },
  "typography": {
    "font_families": [
      "Avenir",
      "Avenir Next",
      "Helvetica Neue",
      "Arial",
      "Optima"
    ],
    "sans_font_families": [
      "Avenir",
      "Avenir Next",
      "Helvetica Neue",
      "Arial"
    ],
    "title_size": 56,
    "headline_size": 42,
    "subtitle_size": 24,
    "body_size": 21,
    "code_size": 20,
    "metric_size": 88,
    "caption_size": 17,
    "badge_size": 15
  },
  "layout": {
    "padding_x": 84,
    "padding_y": 160,
    "card_padding": 40,
    "border_radius": 16,
    "header_style": "cinematic_hud",
    "line_spacing": 14
  },
  "components": {
    "terminal": {
      "show_window_dots": true,
      "window_title": "STREAM SURVEILLANCE // INGESTION GATE",
      "prompt_symbol": "❯",
      "prompt_color": "#06b6d4",
      "command_color": "#f1f5f9",
      "output_color": "#94a3b8",
      "success_color": "#10b981",
      "error_color": "#f43f5e",
      "status_line": "INGESTION GATEWAY • ANOMALY QUARANTINED • 0 DOWNSTREAM LEAKS"
    },
    "chart": {
      "bar_color": "#06b6d4",
      "bar_color_highlight": "#f43f5e",
      "bar_bg": "#111c30",
      "bar_height": 44,
      "bar_radius": 8,
      "grid_color": "#1e293b",
      "label_color": "#f1f5f9",
      "value_color": "#06b6d4"
    },
    "stat": {
      "number_color": "#06b6d4",
      "label_color": "#f1f5f9",
      "rule_color": "#06b6d4"
    }
  }
}
