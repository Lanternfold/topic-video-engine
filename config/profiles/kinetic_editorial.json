{
  "id": "kinetic_editorial",
  "name": "Kinetic Editorial Investigation",
  "description": "High-velocity investigative journalism with stark editorial typography, bold publication rules, dramatic typographic hierarchy, and rapid visual pacing (9:16 vertical)",
  "colors": {
    "background": "#F6F0E6",
    "foreground": "#171820",
    "secondary": "#3D4050",
    "muted": "#74788D",
    "accent": "#FF5C35",
    "accent_secondary": "#FFD447",
    "accent_tertiary": "#65D6C4",
    "card_bg": "#FFFFFF",
    "card_border": "#D8CFBE",
    "code_bg": "#ECE5D7",
    "badge_bg": "#171820",
    "badge_text": "#FFD447",
    "ink": "#171820",
    "paper": "#F6F0E6",
    "coral": "#FF5C35",
    "signal_yellow": "#FFD447",
    "mint": "#65D6C4",
    "semantic_roles": {
      "defect": "#FF5C35",
      "contradiction": "#FF5C35",
      "warning": "#FF5C35",
      "reveal": "#FF5C35",
      "discovery": "#FFD447",
      "key_figure": "#FFD447",
      "question": "#FFD447",
      "validation": "#65D6C4",
      "verified": "#65D6C4"
    }
  },
  "typography": {
    "font_families": [
      "Georgia",
      "Charter",
      "Baskerville",
      "Palatino",
      "Times New Roman"
    ],
    "sans_font_families": [
      "Helvetica Neue",
      "Arial",
      "Futura",
      "Helvetica"
    ],
    "title_size": 64,
    "headline_size": 46,
    "subtitle_size": 26,
    "body_size": 22,
    "code_size": 20,
    "metric_size": 96,
    "caption_size": 18,
    "badge_size": 16
  },
  "layout": {
    "padding_x": 72,
    "padding_y": 140,
    "card_padding": 36,
    "border_radius": 0,
    "header_style": "editorial_rule",
    "line_spacing": 12,
    "mobile_safe_area": {
      "top": 140,
      "bottom": 180,
      "sides": 72
    }
  },
  "components": {
    "terminal": {
      "show_window_dots": false,
      "window_title": "EXHIBIT A // AUDITED STREAM RECORD",
      "prompt_symbol": "›",
      "prompt_color": "#FF5C35",
      "command_color": "#171820",
      "output_color": "#3D4050",
      "success_color": "#65D6C4",
      "error_color": "#FF5C35",
      "warning_color": "#FFD447",
      "status_line": "INGESTION GATE REPORT • DEFECTIVE RECORD QUARANTINED BEFORE PROPAGATION"
    },
    "chart": {
      "bar_color": "#FF5C35",
      "bar_color_highlight": "#FFD447",
      "bar_color_success": "#65D6C4",
      "bar_bg": "#E8E0D1",
      "bar_height": 42,
      "bar_radius": 0,
      "grid_color": "#D8CFBE",
      "label_color": "#171820",
      "value_color": "#171820"
    },
    "stat": {
      "number_color": "#FF5C35",
      "label_color": "#171820",
      "rule_color": "#FF5C35"
    }
  }
}
