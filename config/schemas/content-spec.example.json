{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TopicVideoContentSpec",
  "description": "Content specification schema example for Topic Video Engine (9:16 vertical Reels & Shorts)",
  "type": "object",
  "required": [
    "title",
    "profile",
    "creative_brief",
    "scenes"
  ],
  "properties": {
    "title": {
      "type": "string",
      "description": "Video title"
    },
    "profile": {
      "type": "string",
      "description": "Art-direction base profile ID (e.g. 'developer_workflow', 'editorial_data_story')"
    },
    "creative_brief": {
      "description": "Required creative brief object or path to creative brief JSON file; human approval is required for final rendering",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object"
        }
      ]
    },
    "output": {
      "type": "object",
      "properties": {
        "filename": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "default": 1080
        },
        "height": {
          "type": "integer",
          "default": 1920
        },
        "fps": {
          "type": "integer",
          "default": 30
        }
      }
    },
    "scenes": {
      "type": "array",
      "description": "Ordered list of scenes to render",
      "items": {
        "type": "object",
        "required": [
          "type",
          "headline",
          "duration"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "title",
              "terminal_workflow",
              "data_chart",
              "stat_callout",
              "conclusion"
            ]
          },
          "duration": {
            "type": "number",
            "description": "Scene duration in seconds (must be > 0)"
          },
          "headline": {
            "type": "string"
          },
          "supporting_text": {
            "type": "string"
          },
          "tag": {
            "type": "string"
          },
          "focal_point": {
            "type": "string",
            "description": "Singular visual focal point for the scene"
          },
          "personal_signature": {
            "type": "string",
            "description": "Optional understated creator aside, unexpected connection, or dry observation"
          },
          "footnote": {
            "type": "string"
          },
          "terminal": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string"
              },
              "output": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "data_points": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "label",
                "value"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "value": {
                  "type": "number"
                },
                "unit": {
                  "type": "string"
                }
              }
            }
          },
          "stat_value": {
            "type": "string"
          },
          "stat_label": {
            "type": "string"
          },
          "bullet_points": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "motion": {
            "description": "Optional actual per-frame camera motion. Omit for static rendering.",
            "oneOf": [
              {
                "type": "string",
                "enum": [
                  "static",
                  "push_in",
                  "pull_out",
                  "pan_left",
                  "pan_right"
                ]
              },
              {
                "type": "object",
                "required": [
                  "preset"
                ],
                "properties": {
                  "preset": {
                    "type": "string",
                    "enum": [
                      "static",
                      "push_in",
                      "pull_out",
                      "pan_left",
                      "pan_right"
                    ]
                  },
                  "strength": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 0.25,
                    "default": 0.08
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "captions": {
            "type": "array",
            "description": "Optional burned-in scene-relative captions; times are seconds from scene start and intervals are [start,end).",
            "items": {
              "type": "object",
              "required": [
                "start",
                "end",
                "text"
              ],
              "properties": {
                "start": {
                  "type": "number",
                  "minimum": 0
                },
                "end": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          }
        }
      }
    }
  }
}
